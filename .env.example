# Required for Gemini embeddings and the Gemini analysis worker.
GOOGLE_API_KEY=replace_with_your_google_ai_studio_api_key

# Required for the Groq analysis worker. Create a key in GroqCloud.
GROQ_API_KEY=replace_with_your_groq_api_key

# One worker is created for each provider/model pair. Failed logs are retried
# by another configured worker at most once per worker.
ANALYSIS_WORKERS=gemini:gemini-3.8-flash,groq:qwen/qwen3.8-27b

# Group matching logs over this many seconds before rule triage/model analysis.
LOG_GROUP_WINDOW_SECONDS=5

# Optional; defaults to the local Qdrant started by operate.sh.
# QDRANT_HOST=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=log_anomalies
