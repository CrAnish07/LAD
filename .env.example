# Required for Gemini embeddings and the Gemini analysis worker.
GOOGLE_API_KEY=replace_with_your_google_ai_studio_api_key

# Required for the Groq analysis worker. Create a key in GroqCloud.
GROQ_API_KEY=replace_with_your_groq_api_key

# Optional NanoGPT OpenAI-compatible API worker.
NANOGPT_API_KEY=replace_with_your_nanogpt_api_key
# NANOGPT_BASE_URL=https://nano-gpt.com/api/v1

# Optional Requesty OpenAI-compatible API worker.
REQUESTY_API_KEY=replace_with_your_requesty_api_key
# REQUESTY_BASE_URL=https://router.requesty.ai/v1

# Optional OpenRouter OpenAI-compatible API worker.
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Cloudflare Workers AI Clairic extraction worker.
CLOUDFLARE_ACCOUNT_ID=replace_with_your_cloudflare_account_id
CLOUDFLARE_AUTH_TOKEN=replace_with_a_workers_ai_token

# One worker is created for each configured provider/model pair. Failed logs
# are retried by another configured worker at most once per worker. To enable
# optional providers, append entries such as nanogpt:openai/gpt-6.1-sol,
# requesty:nvidia/nemotron-3.5-lightning-30b-a3b,
# openrouter:recursive/flint-v1.0:free, or
# cloudflare:@cf/cloudflare/clairic to this value.
ANALYSIS_WORKERS=gemini:gemini-3.8-flash,groq:qwen/qwen3.8-27b

# Group matching logs over this many seconds before rule triage/model analysis.
LOG_GROUP_WINDOW_SECONDS=5

# Optional; defaults to the local Qdrant started by operate.sh.
# QDRANT_HOST=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=log_anomalies
